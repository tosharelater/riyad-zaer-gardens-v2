---
import { homeText, type Lang } from '../data/home-i18n';

const { lang = 'fr' } = Astro.props as { lang?: Lang };
const t = homeText[lang];
const nav = t.nav;
const path = new URL(Astro.request.url).pathname.replace(/\/$/, '') || '/';
---
<header class="fixed top-4 inset-x-0 z-50 px-4">
  <div class="mx-auto max-w-[1280px] bg-white rounded-full shadow-[0_10px_40px_-15px_rgba(0,0,0,0.35)] flex items-center justify-between ps-7 pe-2.5 py-2.5">
    <a href={lang === "ar" ? "/ar/" : "/"} class="leading-none">
      <span class="block text-lg font-semibold text-forest tracking-tight">{lang === 'ar' ? 'رياض زعير' : 'Riyad Zaer'} <span class="text-gold">{lang === 'ar' ? 'غاردنز' : 'Gardens'}</span></span>
      <span class="block text-[0.6rem] tracking-[0.22em] uppercase text-ink/45 mt-1">{t.by}</span>
    </a>

    <nav class="hidden lg:flex items-center gap-9 text-sm text-ink/70">
      {nav.map(([label, href]) => (
        <a href={href} class:list={['nav-link hover:text-forest transition-colors', path === href.replace(/\/$/, '') && !href.includes('#') && 'is-active text-forest font-medium']}>
          {label}
        </a>
      ))}
    </nav>

    <div class="hidden lg:flex items-center gap-3">
      <a href={t.switchTo.href} class="text-xs text-ink/55 hover:text-forest border border-ink/15 rounded-full px-3 py-1.5">{t.switchTo.label}</a>
      <a href={lang === 'ar' ? '/ar/#contact' : '/contact'} class="btn btn-dark !rounded-full !py-3.5 !px-6">{t.cta}</a>
    </div>

    <button id="menu-toggle" class="lg:hidden flex flex-col gap-1.5 p-3 me-2" aria-label="Ouvrir le menu" aria-expanded="false">
      <span class="w-6 h-px bg-forest"></span>
      <span class="w-6 h-px bg-forest"></span>
      <span class="w-4 h-px bg-forest self-end"></span>
    </button>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden mx-auto max-w-[1280px] mt-2 bg-white rounded-3xl shadow-xl p-6">
    <nav class="flex flex-col">
      {nav.map(([label, href]) => (
        <a href={href} class="py-3 border-b border-ink/10 text-ink/80">{label}</a>
      ))}
      <a href={t.switchTo.href} class="py-3 border-b border-ink/10 text-ink/80">{t.switchTo.label}</a>
      <a href={lang === 'ar' ? '/ar/#contact' : '/contact'} class="btn btn-dark !rounded-full mt-5 justify-center">{t.cta}</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('hidden') === false;
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
