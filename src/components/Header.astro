---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { pick, type Lang, localeAgnosticPath, stripBase } from '../data/i18n/helpers';
import { nav, switchTo, by } from '../data/i18n/links';

interface Props {
  lang?: Lang;
  theme?: 'light' | 'dark';
}
const { lang = 'fr', theme = 'light' } = Astro.props;
const sw = pick(switchTo, lang);
const byText = pick(by, lang);
const pagePath = localeAgnosticPath(Astro.url.pathname);
const currentPath = stripBase(Astro.url.pathname).replace(/\/$/, '') || '/';
const homeHref = getRelativeLocaleUrl(lang, '/');
const switchHref = lang === 'ar'
  ? getRelativeLocaleUrl('fr', pagePath)
  : getRelativeLocaleUrl('ar', pagePath);
const contactHref = getRelativeLocaleUrl(lang, '/contact');
// On the home page the form is on the page itself
const callbackHref = currentPath === '/' || currentPath === '/ar' ? '#contact' : contactHref;
const dark = theme === 'dark';

const navItems = pick(nav, lang).filter(([label]) => !/contact/i.test(label));
---
{dark ? (
  <header class="lx-header" data-lx-header>
    <div class="lx-header__bar">
      <a href={homeHref} class="lx-header__logo" aria-label={lang === 'ar' ? 'رياض زعير غاردنز' : 'Riyad Zaer Gardens'}>
        <img src="/brand/logo-green.png" alt="" width="720" height="468" class="lx-logo-on-light" />
        <img src="/brand/logo-light.png" alt="" width="720" height="468" class="lx-logo-on-dark" />
        <span class="sr-only">{lang === 'ar' ? 'رياض زعير غاردنز' : 'Riyad Zaer Gardens'} — {byText}</span>
      </a>

      <nav class="lx-header__nav" aria-label={lang === 'ar' ? 'القائمة الرئيسية' : 'Navigation principale'}>
        {navItems.map(([label, href]) => (
          <a href={href}>{label}</a>
        ))}
      </nav>

      <div class="lx-header__actions">
        <a href={switchHref} class="lx-header__lang" hreflang={lang === 'ar' ? 'fr' : 'ar'}>{sw.label}</a>
        <a href={callbackHref} class="lx-btn lx-btn--sm">
          {lang === 'ar' ? 'تسجيل الاهتمام' : 'Être rappelé'}
        </a>
      </div>

      <button id="menu-toggle" class="lx-header__burger" aria-label={lang === 'ar' ? 'فتح القائمة' : 'Ouvrir le menu'} aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span>
      </button>
    </div>

    <div id="mobile-menu" class="lx-header__mobile hidden">
      <nav>
        {navItems.map(([label, href]) => (
          <a href={href}>{label}</a>
        ))}
        <a href={switchHref} hreflang={lang === 'ar' ? 'fr' : 'ar'}>{sw.label}</a>
        <a href={callbackHref} class="lx-btn">{lang === 'ar' ? 'تسجيل الاهتمام' : 'Être rappelé'}</a>
      </nav>
    </div>
  </header>
) : (
  <header class="fixed top-0 inset-x-0 z-50 site-header">
    <div class="mx-auto max-w-[1280px] px-4 sm:px-6 flex items-center justify-between gap-4 py-3 sm:py-4">
      <a href={homeHref} class="shrink-0 leading-none" aria-label={lang === 'ar' ? 'رياض زعير غاردنز' : 'Riyad Zaer Gardens'}>
        <img
          src="/logo-bar-clear.png"
          alt=""
          width="280"
          height="180"
          class="h-14 w-auto object-contain sm:h-16 md:h-[4.5rem]"
        />
        <span class="sr-only">{lang === 'ar' ? 'رياض زعير غاردنز' : 'Riyad Zaer Gardens'} — {byText}</span>
      </a>

      <nav class="hidden lg:flex items-center gap-8 text-sm">
        {navItems.map(([label, href]) => {
          const hrefNorm = href.replace(/\/$/, '') || '/';
          const active = currentPath === hrefNorm && !href.includes('#');
          return (
            <a href={href} class:list={['nav-link site-header__link', active && 'is-active']}>
              {label}
            </a>
          );
        })}
      </nav>

      <div class="hidden lg:flex items-center gap-3">
        <a href={switchHref} class="site-header__lang text-xs border rounded-full px-3 py-1.5" hreflang={lang === 'ar' ? 'fr' : 'ar'}>{sw.label}</a>
        <a href={contactHref} class="btn btn-gold !rounded-full !py-3 !px-5">{lang === 'ar' ? 'نتصل بكم' : 'Être rappelé'}</a>
      </div>

      <button id="menu-toggle" class="lg:hidden flex flex-col gap-1.5 p-2" aria-label={lang === 'ar' ? 'فتح القائمة' : 'Ouvrir le menu'} aria-expanded="false">
        <span class="site-header__burger w-7 h-0.5 bg-forest"></span>
        <span class="site-header__burger w-7 h-0.5 bg-forest"></span>
        <span class="site-header__burger w-5 h-0.5 bg-forest self-end"></span>
      </button>
    </div>

    <div id="mobile-menu" class="hidden lg:hidden mx-4 sm:mx-6 max-w-[1280px] sm:mx-auto bg-white/95 backdrop-blur-md rounded-2xl shadow-xl p-6">
      <nav class="flex flex-col">
        {navItems.map(([label, href]) => (
          <a href={href} class="py-3 border-b border-ink/10 text-ink/80">{label}</a>
        ))}
        <a href={switchHref} class="py-3 border-b border-ink/10 text-ink/80" hreflang={lang === 'ar' ? 'fr' : 'ar'}>{sw.label}</a>
        <a href={contactHref} class="btn btn-dark !rounded-full mt-5 justify-center">{lang === 'ar' ? 'نتصل بكم' : 'Être rappelé'}</a>
      </nav>
    </div>
  </header>
)}

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('hidden') === false;
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });
  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
