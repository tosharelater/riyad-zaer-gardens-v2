---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { pick, type Lang, localeAgnosticPath, stripBase } from '../data/i18n/helpers';
import { nav, switchTo, by } from '../data/i18n/links';

interface Props {
  lang?: Lang;
}
const { lang = 'fr' } = Astro.props;
const navItems = pick(nav, lang);
const sw = pick(switchTo, lang);
const byText = pick(by, lang);
const pagePath = localeAgnosticPath(Astro.url.pathname);
const currentPath = stripBase(Astro.url.pathname).replace(/\/$/, '') || '/';
const homeHref = getRelativeLocaleUrl(lang, '/');
const switchHref = lang === 'ar'
  ? getRelativeLocaleUrl('fr', pagePath)
  : getRelativeLocaleUrl('ar', pagePath);
const contactHref = getRelativeLocaleUrl(lang, '/contact');
---
<header class="fixed top-4 inset-x-0 z-50 px-4 site-header">
  <div class="mx-auto max-w-[1280px] bg-white rounded-full shadow-[0_10px_40px_-15px_rgba(0,0,0,0.35)] flex items-center justify-between ps-5 pe-2.5 py-2">
    <a href={homeHref} class="flex items-center gap-3 leading-none shrink-0" aria-label={lang === 'ar' ? 'رياض زعير غاردنز' : 'Riyad Zaer Gardens'}>
      <img
        src="/logo-bar.png"
        alt=""
        width="160"
        height="102"
        class="h-10 w-auto object-contain sm:h-11"
      />
      <span class="sr-only">{lang === 'ar' ? 'رياض زعير غاردنز' : 'Riyad Zaer Gardens'} — {byText}</span>
    </a>

    <nav class="hidden lg:flex items-center gap-9 text-sm text-ink/70">
      {navItems.map(([label, href]) => {
        const hrefNorm = href.replace(/\/$/, '') || '/';
        const active = currentPath === hrefNorm && !href.includes('#');
        return (
          <a href={href} class:list={['nav-link hover:text-forest transition-colors', active && 'is-active text-forest font-medium']}>
            {label}
          </a>
        );
      })}
    </nav>

    <div class="hidden lg:flex items-center gap-3">
      <a href={switchHref} class="text-xs text-ink/55 hover:text-forest border border-ink/15 rounded-full px-3 py-1.5" hreflang={lang === 'ar' ? 'fr' : 'ar'}>{sw.label}</a>
      <a href={contactHref} class="btn btn-dark !rounded-full !py-3.5 !px-6">{lang === 'ar' ? 'نتصل بكم' : 'Être rappelé'}</a>
    </div>

    <button id="menu-toggle" class="lg:hidden flex flex-col gap-1.5 p-3 me-2" aria-label={lang === 'ar' ? 'فتح القائمة' : 'Ouvrir le menu'} aria-expanded="false">
      <span class="w-6 h-px bg-forest"></span>
      <span class="w-6 h-px bg-forest"></span>
      <span class="w-4 h-px bg-forest self-end"></span>
    </button>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden mx-auto max-w-[1280px] mt-2 bg-white rounded-3xl shadow-xl p-6">
    <nav class="flex flex-col">
      {navItems.map(([label, href]) => (
        <a href={href} class="py-3 border-b border-ink/10 text-ink/80">{label}</a>
      ))}
      <a href={switchHref} class="py-3 border-b border-ink/10 text-ink/80" hreflang={lang === 'ar' ? 'fr' : 'ar'}>{sw.label}</a>
      <a href={contactHref} class="btn btn-dark !rounded-full mt-5 justify-center">{lang === 'ar' ? 'نتصل بكم' : 'Être rappelé'}</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('hidden') === false;
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
