---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from './ContactForm.astro';
import Curves from './Curves.astro';
import { site } from '../data/site';
import { homeText, type Lang } from '../data/home-i18n';
import { pick } from '../data/i18n/helpers';
import { localisation } from '../data/i18n/localisation';

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = homeText[lang];
const ar = lang === 'ar';
const href = (path: string) => getRelativeLocaleUrl(lang, path);
const access = pick(localisation, lang).acces.items.slice(0, 3);
const heroFacts = [t.reassure[0], t.reassure[1], t.reassure[2], t.reassure[5]];
const gallery = [
  { img: '/gallery/render-5.jpg', wide: true },
  { img: '/gallery/render-1.jpg' },
  { img: '/gallery/render-6.jpg', wide: true },
  { img: '/gallery/render-3.jpg' },
  { img: '/gallery/render-12.jpg', wide: true },
  { img: '/gallery/render-9.jpg' },
  { img: '/gallery/render-11.jpg', wide: true },
  { img: '/gallery/render-2.jpg' },
];

const cards = [
  { img: '/gallery/render-3.jpg', title: t.homes.items[0][0], line: t.homes.items[0][1], href: href('/appartements') },
  { img: '/gallery/render-12.jpg', title: t.homes.items[1][0], line: t.homes.items[1][1], href: '#aid' },
  { img: '/gallery/render-8.jpg', title: t.homes.items[2][0], line: t.homes.items[2][1], href: href('/fonds-de-commerce') },
];

const slides = t.why.items.map(([title, body], i) => ({
  title,
  body,
  ...[
    { img: '/gallery/render-1.jpg', pos: 'center' },
    { img: '/gallery/render-6.jpg', pos: 'center' },
    { img: '/gallery/render-9.jpg', pos: 'center' },
    { img: '/gallery/render-11.jpg', pos: 'center' },
  ][i],
}));
---
<BaseLayout title={t.htmlTitle} description={t.htmlDesc} lang={lang}>
  <!-- Hero -->
  <section data-hero id="overview" class="lx-hero">
    <div class="lx-hero__media" data-hero-media>
      <img src="/gallery/render-5.jpg" alt={t.hero.alt} class="lx-hero__img" fetchpriority="high" />
      <!-- Plays once public/cinematic/hero.mp4 exists; the render stays visible until then. -->
      <video class="lx-hero__video" data-hero-video muted loop playsinline preload="metadata" poster="/gallery/render-5.jpg" aria-hidden="true">
        <source src="/cinematic/hero.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="lx-hero__copy">
      <p class="lx-hero__kicker">{t.hero.eyebrow}<br />{t.hero.h1}</p>
      <h1 class="lx-hero__title">{ar ? t.brand : (<>Riyad Zaer<br />Gardens</>)}</h1>
      <div class="lx-actions">
        <a href={href('/le-projet')} class="lx-btn lx-btn--solid lx-btn--wide">{t.hero.b1}</a>
        <a href="#contact" class="lx-btn lx-btn--wide">{t.hero.b2}</a>
      </div>
    </div>
    <ul class="lx-herobar">
      {heroFacts.map((f) => <li>{f}</li>)}
    </ul>
  </section>

  <!-- Statement framed by lines -->
  <section class="lx-statement">
    <Curves side="right" id="curves-a" />
    <Curves side="left" id="curves-b" />
    <p>{t.hero.text}</p>
  </section>

  <!-- Introducing: copy and key figures beside the aerial view -->
  <section id="projet" class="lx-intro">
    <div class="lx-intro__copy">
      <p class="lx-kick">{t.projet.eyebrow}</p>
      <h2 class="lx-display">{ar ? t.brand : (<>Riyad Zaer<br />Gardens</>)}</h2>
      <span class="lx-rule" aria-hidden="true"></span>
      <p class="lx-body">{t.projet.p1}</p>
      <dl class="lx-figs">
        {t.figures.items.map(([v, l]) => (<div><dt class="lx-figure__n">{v}</dt><dd>{l}</dd></div>))}
      </dl>
      <a href={href('/le-projet')} class="lx-btn">{t.projet.btn}</a>
    </div>
    <figure class="lx-intro__media">
      <img src="/gallery/render-4.jpg" alt="" loading="lazy" />
    </figure>
  </section>

  <!-- The residences -->
  <section id="residences" class="lx-residences">
    <header class="lx-heading">
      <h2 class="lx-display">{t.homes.eyebrow}</h2>
      <p class="lx-lead">{t.hero.price}</p>
    </header>
    <div class="lx-cards">
      {cards.map((c) => (
        <article class="lx-card">
          <a href={c.href} class="lx-card__media" tabindex="-1" aria-hidden="true">
            <img src={c.img} alt="" loading="lazy" />
          </a>
          <h3 class="lx-card__title">{c.title}</h3>
          <p class="lx-card__line">{c.line}</p>
          <a href={c.href} class="lx-btn lx-btn--solid lx-btn--sm">{t.homes.more}</a>
        </article>
      ))}
    </div>
  </section>

  <!-- Gallery: drag or use the arrows -->
  <section class="lx-gallery" aria-label={ar ? 'معرض الصور' : 'Galerie'} data-gallery>
    <div class="lx-gallery__head">
      <h2 class="lx-h2">{ar ? 'معرض الصور' : 'Galerie'}</h2>
      <div class="lx-gallery__nav">
        <span class="lx-gallery__count" dir="ltr"><b data-gallery-index>01</b> / {String(gallery.length).padStart(2, '0')}</span>
        <button type="button" class="lx-arrow" data-gallery-prev aria-label={ar ? 'السابق' : 'Précédent'}>←</button>
        <button type="button" class="lx-arrow" data-gallery-next aria-label={ar ? 'التالي' : 'Suivant'}>→</button>
      </div>
    </div>
    <ul class="lx-gallery__track" data-gallery-track>
      {gallery.map((g) => (
        <li class:list={['lx-gallery__item', g.wide && 'is-wide']}><img src={g.img} alt="" loading="lazy" draggable="false" /></li>
      ))}
    </ul>
  </section>

  <!-- Lifestyle: pinned full-bleed story -->
  <section id="lifestyle">
    <div class="lx-carousel" data-story>
      {slides.map((s, i) => (
        <article class="lx-slide" data-slide>
          <img src={s.img} alt="" loading={i === 0 ? 'eager' : 'lazy'} style={`object-position:${s.pos}`} />
          <div class="lx-slide__copy">
            <p class="lx-slide__index" dir="ltr">{String(i + 1).padStart(2, '0')} / {String(slides.length).padStart(2, '0')}</p>
            <h2 class="lx-slide__title">{s.title}</h2>
            <span class="lx-rule" aria-hidden="true"></span>
            <p class="lx-slide__body">{s.body}</p>
          </div>
        </article>
      ))}
      <div class="lx-carousel__nav" aria-hidden="true">
        {slides.map((_, i) => (
          <span class:list={['lx-dot', i === 0 && 'is-active']} data-dot={i}></span>
        ))}
      </div>
    </div>
  </section>

  <!-- Location: address, sentence and access over the photo -->
  <section id="localisation" class="lx-band">
    <img src="/gallery/render-7.jpg" alt={t.loc.alt} loading="lazy" />
    <div class="lx-band__copy">
      <p class="lx-kick">{t.hero.eyebrow}</p>
      <h2 class="lx-display">{t.loc.h2}</h2>
      <p class="lx-band__text">{t.loc.text}</p>
      <a href={href('/localisation')} class="lx-btn">{t.loc.btn}</a>
    </div>
    <ul class="lx-band__access">
      {access.map((it) => (<li><h3>{it.title}</h3><p>{it.body}</p></li>))}
    </ul>
  </section>

  <!-- Housing aid: title beside a price card -->
  <section id="aid" class="lx-aid2">
    <div>
      <p class="lx-kick">{t.aid.eyebrow}</p>
      <h2 class="lx-h2">{t.aid.h2}</h2>
      <p class="lx-stext">{t.aid.note}</p>
    </div>
    <div class="lx-pricecard">
      <p><span>{t.aid.without}</span><s>{t.aid.withoutVal}</s></p>
      <p><span>{t.aid.withAid}</span><strong>{t.aid.withVal}</strong></p>
      <a href="#contact" class="lx-btn lx-btn--solid">{t.aid.btn}</a>
    </div>
  </section>

  <!-- Register: pitch and direct lines beside the form -->
  <section id="contact" class="lx-contact lx-dark">
    <Curves side="right" id="curves-d" />
    <div class="lx-contact__grid">
      <div class="lx-contact__pitch">
        <h2 class="lx-display">{t.contact.h2}</h2>
        <p class="lx-body">{t.contact.text}</p>
        <a href={`tel:${site.phoneTel}`} class="lx-contact__phone" dir="ltr">{site.phone}</a>
        <a href={site.whatsapp} class="lx-more">{t.contact.wa}</a>
      </div>
      <div class="lx-contact__form">
        <ContactForm lang={lang} />
      </div>
    </div>
  </section>

  <!-- render-10 carries thumbnail strips in its lower quarter: cropped from the top -->
  <div class="lx-closing" aria-hidden="true">
    <img src="/gallery/render-10.jpg" alt="" loading="lazy" />
  </div>
</BaseLayout>
