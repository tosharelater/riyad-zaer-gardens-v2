---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from './ContactForm.astro';
import { site } from '../data/site';
import { homeText, type Lang } from '../data/home-i18n';

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = homeText[lang];
const ar = lang === 'ar';

const cards = [
  { img: '/gallery/render-1.jpg', title: t.homes.items[0][0], line: t.homes.items[0][1], href: t.homes.items[0][3] },
  { img: '/gallery/render-6.jpg', title: t.homes.items[1][0], line: t.homes.items[1][1], href: t.homes.items[1][3] },
  { img: '/gallery/render-8.jpg', title: t.homes.items[2][0], line: t.homes.items[2][1], href: t.homes.items[2][3] },
];

const slides = t.why.items.map((item, i) => ({
  img: ['/gallery/render-12.jpg', '/gallery/render-3.jpg', '/gallery/render-7.jpg', '/gallery/render-11.jpg'][i],
  title: item[0],
  body: item[1],
}));
---
<BaseLayout title={t.htmlTitle} description={t.htmlDesc} lang={lang} theme="dark">
  <!-- 1. HERO — Bugatti pattern: kicker + line + brand + one CTA -->
  <section data-hero id="overview" class="bz-hero">
    <div data-hero-bg class="bz-hero__media">
      <img src="/cinematic/hero.png" alt={t.hero.alt} class="bz-hero__img" />
      <div class="bz-hero__veil"></div>
    </div>
    <div data-hero-content class="bz-hero__copy">
      <p class="bz-hero__kicker">{t.hero.eyebrow}</p>
      <h1 class="bz-hero__line">{t.hero.h1}</h1>
      <p class="bz-hero__brand">
        {ar ? t.brand : (<>RIYAD ZAER<br /><span>GARDENS</span></>)}
      </p>
      <a href="#projet" class="rz-btn rz-btn--outline">{t.hero.b1}</a>
    </div>
  </section>

  <!-- 2. MANIFESTO -->
  <section class="bz-manifesto">
    <p class="bz-manifesto__text">{t.hero.text}</p>
  </section>

  <!-- 3. INTRODUCING -->
  <section id="projet" class="bz-intro">
    <div class="bz-intro__media">
      <img src="/gallery/render-4.jpg" alt="" class="bz-intro__img" />
      <div class="bz-intro__veil"></div>
    </div>
    <div class="bz-intro__copy">
      <p class="bz-kicker">{t.projet.eyebrow}</p>
      <h2 class="bz-brand">
        {ar ? t.brand : (<>RIYAD ZAER<br /><span>GARDENS</span></>)}
      </h2>
      <div class="bz-rule"></div>
      <p class="bz-lead">{t.projet.p1}</p>
      <p class="bz-lead bz-lead--soft">{t.projet.p2}</p>
      <a href={t.projet.btnHref} class="rz-btn rz-btn--outline">{t.projet.btn}</a>
    </div>
  </section>

  <!-- 4. ENQUIRE -->
  <section class="bz-enquire">
    <a href="#contact" class="rz-btn rz-btn--outline rz-btn--wide">{t.hero.b2}</a>
  </section>

  <!-- 5. RESIDENCES -->
  <section id="residences" class="bz-residences">
    <header class="bz-head">
      <h2 class="bz-title">{ar ? t.homes.h2 : (<>Les<br />Résidences</>)}</h2>
      <p class="bz-sub">{t.homes.text}</p>
    </header>
    <div class="bz-cards">
      {cards.map((c, i) => (
        <article class="bz-card" data-rz-card style={`--i:${i}`}>
          <a href={c.href} class="bz-card__media">
            <img src={c.img} alt={c.title} loading="lazy" />
          </a>
          <h3 class="bz-card__title">{c.title}</h3>
          <p class="bz-card__line">{c.line}</p>
          <a href={c.href} class="bz-card__more">{t.homes.more}</a>
        </article>
      ))}
    </div>
  </section>

  <!-- 6. FIGURES -->
  <section class="bz-figures">
    {t.figures.items.map(([v, l]) => (
      <div class="bz-figure">
        <p class="bz-figure__n" data-count={v}>{v}</p>
        <p class="bz-figure__l">{l}</p>
      </div>
    ))}
  </section>

  <!-- 7. LIFESTYLE -->
  <section id="lifestyle" class="bz-life" data-lifestyle>
    {slides.map((s) => (
      <article class="bz-life__slide" data-lifestyle-slide>
        <img src={s.img} alt="" loading="lazy" class="bz-life__img" />
        <div class="bz-life__veil"></div>
        <div class="bz-life__copy">
          <h2 class="bz-life__title">{s.title}</h2>
          <div class="bz-rule"></div>
          <p class="bz-life__body">{s.body}</p>
        </div>
      </article>
    ))}
    <div class="bz-life__dots" data-lifestyle-dots aria-hidden="true">
      {slides.map((_, i) => <span class:list={[i === 0 && 'is-active']}></span>)}
    </div>
  </section>

  <!-- 8. WAYS -->
  <section class="bz-ways">
    {t.ways.items.map(([title, body]) => (
      <article class="bz-way">
        <h3 class="bz-way__title">{title}</h3>
        <p class="bz-way__body">{body}</p>
      </article>
    ))}
  </section>

  <!-- 9. AID -->
  <section id="aid" class="bz-aid">
    <p class="bz-kicker">{t.aid.eyebrow}</p>
    <h2 class="bz-title bz-title--md">{t.aid.h2}</h2>
    <p class="bz-sub bz-sub--center">{t.aid.text}</p>
    <div class="bz-aid__row">
      <div class="bz-aid__cell">
        <p class="bz-aid__label">{t.aid.without}</p>
        <p class="bz-aid__val">{t.aid.withoutVal}</p>
      </div>
      <div class="bz-aid__cell bz-aid__cell--hl">
        <p class="bz-aid__label">{t.aid.withAid}</p>
        <p class="bz-aid__val">{t.aid.withVal}</p>
      </div>
    </div>
    <a href="#contact" class="rz-btn rz-btn--outline">{t.aid.btn}</a>
  </section>

  <!-- 10. LOCATION -->
  <section id="localisation" class="bz-loc">
    <div class="bz-loc__copy">
      <p class="bz-kicker">{t.loc.eyebrow}</p>
      <h2 class="bz-title bz-title--left">{t.loc.h2}</h2>
      <div class="bz-rule"></div>
      <p class="bz-lead">{t.loc.text}</p>
      {!ar && <a href="/localisation" class="rz-btn rz-btn--outline">{t.loc.btn}</a>}
    </div>
    <div class="bz-loc__media">
      <img src="/gallery/render-11.jpg" alt={t.loc.alt} loading="lazy" />
    </div>
  </section>

  <!-- 11. CONTACT -->
  <section id="contact" class="bz-contact">
    <div class="bz-contact__visual">
      <img src="/gallery/render-2.jpg" alt="" loading="lazy" class="bz-contact__bg" />
      <div class="bz-contact__overlay">
        <h2 class="bz-brand bz-brand--sm">{t.contact.h2}</h2>
        <p class="bz-lead">{t.contact.text}</p>
        <a href={`tel:${site.phoneTel}`} class="bz-phone" dir="ltr">{site.phone}</a>
      </div>
    </div>
    <div class="bz-contact__form">
      <ContactForm lang={lang} />
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/motion';
</script>
