---
import { pick, type Lang } from '../data/i18n/helpers';
import { homeText } from '../data/home-i18n';

interface Props { lang?: Lang }
const { lang = 'fr' } = Astro.props;
const t = pick(homeText, lang);
const ways = t.ways.items.map(([verb, body]) => ({ verb, body }));
---
<div class="grid md:grid-cols-3 gap-8">
  {ways.map((w) => (
    <div class="border-t-2 border-gold pt-6">
      <p class="font-display text-3xl md:text-4xl text-forest mb-3">{w.verb}</p>
      <p class="text-sm text-ink/65 leading-relaxed">{w.body}</p>
    </div>
  ))}
</div>
