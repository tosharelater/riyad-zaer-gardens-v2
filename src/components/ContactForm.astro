---
import { homeText, type Lang } from '../data/home-i18n';
import { contactInterests } from '../data/site';

const { lang = 'fr' } = Astro.props as { lang?: Lang };
const f = homeText[lang].contact.form;
const options = lang === 'ar' ? f.options : contactInterests;
const action = lang === 'ar' ? '/ar/merci' : '/merci';
---
<form action={action} method="get" class="rz-form">
  <div class="hidden">
    <label>Ne pas remplir<input type="text" name="societe" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="rz-form__field">
    <label for="nom" class="rz-form__label">{f.name}</label>
    <input id="nom" name="nom" type="text" required class="rz-form__input" />
  </div>

  <div class="rz-form__row">
    <div class="rz-form__field">
      <label for="telephone" class="rz-form__label">{f.phone}</label>
      <input id="telephone" name="telephone" type="tel" required class="rz-form__input" />
    </div>
    <div class="rz-form__field">
      <label for="email" class="rz-form__label">{f.email}</label>
      <input id="email" name="email" type="email" class="rz-form__input" />
    </div>
  </div>

  <div class="rz-form__field">
    <label for="interet" class="rz-form__label">{f.project}</label>
    <select id="interet" name="interet" required class="rz-form__input">
      <option value="">{f.choose}</option>
      {options.map((i) => <option value={i}>{i}</option>)}
    </select>
  </div>

  <div class="rz-form__field">
    <label for="message" class="rz-form__label">{f.message}</label>
    <textarea id="message" name="message" rows="3" class="rz-form__input"></textarea>
  </div>

  <button type="submit" class="rz-btn rz-btn--outline rz-btn--wide lx-btn lx-btn--wide">{f.send}</button>

  <p class="rz-form__note">{f.note}</p>
</form>
