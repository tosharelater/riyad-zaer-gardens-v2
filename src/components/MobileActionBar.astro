---
import { site } from '../data/site';
import type { Lang } from '../data/i18n/helpers';

interface Props {
  lang?: Lang;
  theme?: 'light' | 'dark';
}
const { lang = 'fr', theme = 'light' } = Astro.props;
const dark = theme === 'dark';
const m =
  lang === 'ar'
    ? { call: 'اتصال', wa: 'واتساب', cb: 'نتصل بكم', cbHref: '/ar/contact' }
    : { call: 'Appeler', wa: 'WhatsApp', cb: 'Être rappelé', cbHref: '/contact' };
---
<div class:list={[
  'fixed bottom-0 inset-x-0 z-50 md:hidden grid grid-cols-3 border-t',
  dark ? 'lx-mbar' : 'bg-forest text-cream border-white/10',
]}>
  <a href={`tel:${site.phoneTel}`} class="flex flex-col items-center justify-center gap-1 py-2.5 text-xs font-medium tracking-wide uppercase">
    {m.call}
  </a>
  <a
    href={site.whatsapp}
    class:list={[
      'flex flex-col items-center justify-center gap-1 py-2.5 text-xs font-medium tracking-wide uppercase border-x',
      dark ? 'lx-mbar__mid' : 'border-white/10 text-gold',
    ]}
  >
    {m.wa}
  </a>
  <a
    href={m.cbHref}
    class:list={[
      'flex flex-col items-center justify-center gap-1 py-2.5 text-xs font-medium tracking-wide uppercase',
      dark ? 'lx-mbar__cta' : 'bg-gold text-forest',
    ]}
  >
    {m.cb}
  </a>
</div>
