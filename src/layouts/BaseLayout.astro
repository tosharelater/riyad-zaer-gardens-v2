---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import '../styles/global.css';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Lang } from '../data/i18n/helpers';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  lang?: Lang;
}

const { title, description, noindex = false } = Astro.props;
const lang = (Astro.props.lang ?? Astro.currentLocale ?? 'fr') as Lang;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = (Astro.url.pathname.slice(baseUrl.length) || '/').replace(/^\/ar(\/|$)/, '/');

const frUrl = getRelativeLocaleUrl('fr', path);
const arUrl = getRelativeLocaleUrl('ar', path);
---
<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && (<><link rel="alternate" hreflang="fr" href={frUrl} /><link rel="alternate" hreflang="ar" href={arUrl} /></>)}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />
    <noscript><style>.reveal { opacity: 1 !important; transform: none !important; }</style></noscript>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header lang={lang} />
    <main class="flex-1 pb-20 md:pb-0">
      <slot />
    </main>
    <Footer lang={lang} />
    <MobileActionBar lang={lang} />

    <script>
      const header = document.querySelector('.site-header');
      const onScroll = () => {
        if (!header) return;
        header.classList.toggle('is-scrolled', window.scrollY > 12);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      const motionPage = !!document.querySelector('[data-hero]');
      const targets = motionPage ? [] : document.querySelectorAll(
        'main section:not(.hero) .container-page > *, main section:not(.hero) .container-page > div > *'
      );
      targets.forEach((el, i) => {
        el.classList.add('reveal');
        (el as HTMLElement).style.transitionDelay = `${Math.min(i % 5, 4) * 90}ms`;
      });

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Safety net: never leave content permanently hidden.
      setTimeout(() => {
        document.querySelectorAll('.reveal:not(.is-visible)').forEach((el) => el.classList.add('is-visible'));
      }, 1400);
    </script>
  </body>
</html>
