---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import CtaBlock from '../components/CtaBlock.astro';
import HousingAidBanner from '../components/HousingAidBanner.astro';
import SpecTable from '../components/SpecTable.astro';
import NumberedFeatures from '../components/NumberedFeatures.astro';
import ThreeWays from '../components/ThreeWays.astro';
import PhotoCollage from '../components/PhotoCollage.astro';
import { site } from '../data/site';

const typologies = [
  { name: 'Appartement F3', surface: 'environ 68 à 72 m²', rooms: '2 chambres', body: 'Un séjour, deux chambres, une cuisine et une salle de bain. Selon le lot : balcon ou terrasse, buanderie et placards intégrés.', image: '/gallery/render-1.jpg' },
  { name: 'Appartement F4', surface: 'environ 77 à 86 m²', rooms: '3 chambres', body: 'Un séjour, trois chambres, une cuisine, une salle de bain et un WC séparé. Selon le lot : balcon ou terrasse, buanderie et placards intégrés.', image: '/gallery/render-6.jpg' },
];

const included = [
  'Finitions modernes, faux plafonds et éclairage intégrés',
  'Balcon ou terrasse selon le lot',
  'Ascenseur dans chaque immeuble',
  'Résidence sécurisée et gardiennée',
  'Cœur d’îlot végétalisé et aires de jeux',
  'Place de parking couverte en sous-sol, disponible en supplément',
];

const finishes = [
  { label: 'Sols', value: 'Carreau céramique ou parquet stratifié' },
  { label: 'Salle de bain', value: 'Douche à l’italienne, sanitaires et robinetterie Roca' },
  { label: 'Menuiseries extérieures', value: 'Aluminium' },
  { label: 'Volets', value: 'Volets roulants motorisés Somfy' },
  { label: 'Portes intérieures', value: 'Finition bois' },
  { label: 'Plafonds', value: 'Faux plafonds avec éclairage LED intégré' },
  { label: 'Cuisine', value: 'Meubles en MDF' },
  { label: 'Parties communes', value: 'Éclairage LED, détecteurs de mouvement' },
];

const reasons = [
  { title: 'Un cœur d’îlot végétalisé', body: 'Une cour centrale plantée, calme et réservée aux résidents, qui apporte lumière et fraîcheur.' },
  { title: 'À 20 minutes de Rabat', body: 'Sur l’Avenue Mohammed VI, avec un accès direct à l’autoroute.' },
  { title: 'Des appartements livrés finis', body: 'Aucun travaux à prévoir avant d’emménager.' },
  { title: 'Un prix juste', body: 'Un logement de moyen standing à un prix accessible.' },
];
---
<BaseLayout
  title="Appartements F3 et F4 à Aïn Aouda — Riyad Zaer Gardens"
  description="Appartements neufs F3 et F4 de 65 à 86 m² à Aïn Aouda, livrés finis. À partir de 420 000 DH, ou 350 000 DH avec l'aide au logement. Livraison 2028."
>
  <section class="hero relative bg-forest text-cream overflow-hidden">
    <div class="absolute inset-0">
      <img src="/gallery/render-6.jpg" alt="Appartements F3 et F4 Riyad Zaer Gardens" class="w-full h-full object-cover opacity-40" />
      <div class="absolute inset-0 bg-gradient-to-t from-forest via-forest/80 to-forest/50"></div>
    </div>
    <div class="relative container-page py-24 md:py-32">
      <Eyebrow label="Appartements" />
      <h1 class="font-display text-4xl md:text-5xl mt-5 leading-tight max-w-2xl animate-fade-up">Appartements F3 et F4 à {site.location}</h1>
      <div class="divider-gold my-7 animate-fade-up" style="animation-delay:.15s"></div>
      <p class="max-w-xl text-cream/75 animate-fade-up" style="animation-delay:.25s">
        La première tranche de Riyad Zaer Gardens compte 120 appartements, répartis en deux typologies : F3 et F4, de 65 à 86 m². Tous les logements sont livrés finis.
      </p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-page">
      <div class="max-w-2xl mb-16">
        <Eyebrow index="01." label="Typologies" />
        <h2 class="font-display text-4xl md:text-6xl text-forest mt-4 mb-5">Deux typologies, de 65 à 86 m²</h2>
        <p class="text-ink/65">Les surfaces varient selon l’étage et la position dans la résidence. Un conseiller vous indique les lots encore disponibles.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        {typologies.map((t) => (
          <div class="group overflow-hidden border border-forest/10 transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl">
            <div class="overflow-hidden">
              <img src={t.image} alt={t.name} class="w-full aspect-[4/3] object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
            </div>
            <div class="p-7">
              <div class="flex items-baseline justify-between mb-4">
                <h3 class="font-display text-2xl text-forest">{t.name}</h3>
                <span class="text-sm text-gold font-semibold">{t.surface}</span>
              </div>
              <p class="text-xs uppercase tracking-wide text-ink/40 mb-4">{t.rooms}</p>
              <p class="text-sm text-ink/65 leading-relaxed">{t.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section overflow-hidden">
    <div class="container-page grid md:grid-cols-2 gap-16 md:gap-24 items-center">
      <div class="md:pl-8">
        <PhotoCollage
          images={['/gallery/render-9.jpg', '/gallery/render-12.jpg', '/gallery/render-1.jpg']}
          alt="Appartement livré fini Riyad Zaer Gardens"
          badgeIcon="sparkle"
          badgeValue="Fini"
          badgeLabel="Prêt à vivre"
        />
      </div>
      <div>
        <Eyebrow index="02." label="Inclus" />
        <h2 class="font-display text-4xl md:text-6xl text-forest mt-4 mb-6">Des logements livrés finis</h2>
        <p class="text-ink/70 leading-relaxed mb-6">
          Les appartements sont livrés avec leurs finitions, dans un standing moderne et sobre. L’objectif est que le logement soit prêt à vivre dès la remise des clés.
        </p>
        <ul class="space-y-3">
          {included.map((i) => (
            <li class="flex items-start gap-3 text-sm text-ink/70 border-b border-forest/10 pb-3"><span class="text-gold mt-0.5">✓</span>{i}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="finitions" class="section bg-white scroll-mt-24">
    <div class="container-page max-w-3xl">
      <Eyebrow index="03." label="Finitions" />
      <h2 class="font-display text-4xl md:text-6xl text-forest mt-4 mb-5">Le détail des finitions</h2>
      <p class="text-ink/65 mb-10">
        Les matériaux ont été choisis pour durer et rester faciles à entretenir. La pose est soignée : alignements, joints réguliers, raccords nets, et une cohérence de teintes d’une pièce à l’autre.
      </p>
      <SpecTable rows={finishes} />
      <p class="mt-8 text-ink/65">Le détail complet des prestations figure dans la brochure du projet. Demandez-la, nous vous l’envoyons.</p>
      <a href="/contact" class="btn btn-dark mt-6">Recevoir la brochure</a>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-page max-w-2xl">
      <Eyebrow index="04." label="Prix" />
      <h2 class="font-display text-4xl md:text-6xl text-forest mt-4 mb-6">Des prix à partir de {site.priceFrom}</h2>
      <p class="text-ink/65 leading-relaxed mb-10">
        Le prix dépend de la typologie, de la surface et de l’étage. Si vous êtes éligible à l’aide au logement, ce prix peut descendre à {site.priceWithAid}.
      </p>
      <div class="grid grid-cols-2 gap-6 mb-10 max-w-sm">
        <div class="frame-corners p-6 text-center">
          <p class="text-xs text-ink/45 mb-2 uppercase tracking-wide">Sans aide</p>
          <p class="font-display text-2xl text-forest">{site.priceFrom}</p>
        </div>
        <div class="frame-corners bg-gold/10 p-6 text-center">
          <p class="text-xs text-gold mb-2 uppercase tracking-wide">Avec l’aide</p>
          <p class="font-display text-2xl text-gold">{site.priceWithAid}</p>
        </div>
      </div>
      <a href="/contact" class="btn btn-dark">Recevoir la brochure et les prix</a>
    </div>
  </section>

  <HousingAidBanner text="Les surfaces et les prix des appartements ont été conçus dès l'origine pour répondre aux conditions du programme d'aide au logement. L'éligibilité dépend ensuite de votre situation personnelle : nos conseillers la vérifient avec vous, sans engagement." />

  <section class="section bg-white">
    <div class="container-page">
      <div class="max-w-2xl mb-16">
        <Eyebrow index="05." label="Le quartier" />
        <h2 class="font-display text-4xl md:text-6xl text-forest mt-4 mb-5">Un appartement, et un quartier autour</h2>
        <p class="text-ink/65">Acheter à Riyad Zaer Gardens, c’est s’installer dans une résidence organisée autour d’une cour centrale plantée, à 20 minutes de Rabat.</p>
      </div>
      <NumberedFeatures items={reasons} />
      <a href="/le-projet" class="inline-block mt-10 text-sm font-semibold text-gold">Découvrir le projet en détail →</a>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <Eyebrow index="06." label="Pour vous" />
      <h2 class="font-display text-4xl md:text-6xl text-forest mt-4 mb-14">Trois façons d’être à Riyad Zaer Gardens</h2>
      <ThreeWays />
    </div>
  </section>

  <CtaBlock title="Recevez la brochure du projet" text="Laissez-nous vos coordonnées. Un conseiller vous rappelle avec la brochure, les typologies disponibles et les prix à jour." />
</BaseLayout>
