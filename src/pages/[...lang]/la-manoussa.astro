---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/v3/PageHero.astro';
import Sec from '../../components/v3/Sec.astro';
import SecHead from '../../components/v3/SecHead.astro';
import Cta from '../../components/v3/Cta.astro';
import { site } from '../../data/site';
import { pick, type Lang } from '../../data/i18n/helpers';
import { manoussa } from '../../data/i18n/manoussa';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'ar' } }];
}

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = pick(manoussa, lang);
const projetHref = lang === 'ar' ? '/ar/le-projet' : '/le-projet';

const fill = (s: string) =>
  s
    .replaceAll('{promoter}', site.promoter)
    .replaceAll('{architect}', site.architect)
    .replaceAll('{location}', site.location)
    .replaceAll('{delivery}', site.delivery)
    .replaceAll('{buildings}', String(site.buildings))
    .replaceAll('{apartments}', String(site.apartments))
    .replaceAll('{commercial}', String(site.commercial));
---
<BaseLayout title={t.meta.title} description={t.meta.description} lang={lang}>
  <PageHero eyebrow={t.hero.eyebrow} title={fill(t.hero.h1)} text={fill(t.hero.p)} />

  <Sec narrow>
    <SecHead index="01" kicker={t.approche.eyebrow} title={t.approche.h2} text={fill(t.approche.p)} />
  </Sec>

  <Sec tone="alt" narrow>
    <SecHead index="02" kicker={t.projets.eyebrow} title={t.projets.h2} />
    <a href={projetHref} class="lx-link lx-link--wide">
      <h3>{t.projets.cardTitle}</h3>
      <p>{fill(t.projets.cardText)}</p>
      <span class="lx-link__go" aria-hidden="true">→</span>
    </a>
  </Sec>

  <Cta lang={lang} title={t.cta.title} text={t.cta.text} />
</BaseLayout>
