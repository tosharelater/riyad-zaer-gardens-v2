---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import { site } from '../../data/site';
import { pick, type Lang } from '../../data/i18n/helpers';
import { manoussa } from '../../data/i18n/manoussa';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'ar' } }];
}

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = pick(manoussa, lang);
const projetHref = lang === 'ar' ? '/ar/le-projet' : '/le-projet';

const fill = (s: string) =>
  s
    .replaceAll('{promoter}', site.promoter)
    .replaceAll('{architect}', site.architect)
    .replaceAll('{location}', site.location)
    .replaceAll('{delivery}', site.delivery)
    .replaceAll('{buildings}', String(site.buildings))
    .replaceAll('{apartments}', String(site.apartments))
    .replaceAll('{commercial}', String(site.commercial));
---
<BaseLayout title={t.meta.title} description={t.meta.description} lang={lang}>
  <section class="bg-forest text-cream">
    <div class="container-page py-16 md:py-20">
      <Eyebrow label={t.hero.eyebrow} />
      <h1 class="font-display text-4xl md:text-5xl mt-4 max-w-2xl leading-tight">{fill(t.hero.h1)}</h1>
      <p class="mt-6 max-w-xl text-cream/75" set:html={fill(t.hero.p)} />
    </div>
  </section>

  <section class="py-16 md:py-24 bg-white">
    <div class="container-page max-w-3xl">
      <Eyebrow index="01." label={t.approche.eyebrow} />
      <h2 class="font-display text-3xl md:text-4xl text-forest mt-3 mb-5">{t.approche.h2}</h2>
      <p class="text-ink/70 leading-relaxed">{fill(t.approche.p)}</p>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="container-page max-w-3xl">
      <Eyebrow index="02." label={t.projets.eyebrow} />
      <h2 class="font-display text-3xl md:text-4xl text-forest mt-3 mb-8">{t.projets.h2}</h2>
      <a href={projetHref} class="block border border-forest/10 p-6 hover:border-gold transition-colors">
        <h3 class="font-display text-xl text-forest mb-2">{t.projets.cardTitle}</h3>
        <p class="text-sm text-ink/65 leading-relaxed">{fill(t.projets.cardText)}</p>
      </a>
    </div>
  </section>

  <CtaBlock lang={lang} title={t.cta.title} text={t.cta.text} />
</BaseLayout>
