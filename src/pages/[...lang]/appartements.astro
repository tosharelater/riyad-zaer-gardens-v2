---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/v3/PageHero.astro';
import Sec from '../../components/v3/Sec.astro';
import SecHead from '../../components/v3/SecHead.astro';
import Split from '../../components/v3/Split.astro';
import SpecList from '../../components/v3/SpecList.astro';
import Numbered from '../../components/v3/Numbered.astro';
import Checklist from '../../components/v3/Checklist.astro';
import AidBand from '../../components/v3/AidBand.astro';
import Cta from '../../components/v3/Cta.astro';
import { homeText } from '../../data/home-i18n';
import { site } from '../../data/site';
import { pick, type Lang } from '../../data/i18n/helpers';
import { appartements } from '../../data/i18n/appartements';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'ar' } }];
}

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = pick(appartements, lang);
const contactHref = lang === 'ar' ? '/ar/contact' : '/contact';
const projetHref = lang === 'ar' ? '/ar/le-projet' : '/le-projet';
const ways = homeText[lang].ways.items;

const fill = (s: string) =>
  s
    .replaceAll('{location}', site.location)
    .replaceAll('{priceFrom}', site.priceFrom)
    .replaceAll('{priceWithAid}', site.priceWithAid);

const finishes = [
  { label: t.finitions.rows[0], value: t.finitions.sols },
  { label: t.finitions.rows[1], value: t.finitions.bain },
  { label: t.finitions.rows[2], value: t.finitions.menuiseries },
  { label: t.finitions.rows[3], value: t.finitions.volets },
  { label: t.finitions.rows[4], value: t.finitions.portes },
  { label: t.finitions.rows[5], value: t.finitions.plafonds },
  { label: t.finitions.rows[6], value: t.finitions.cuisine },
  { label: t.finitions.rows[7], value: t.finitions.communes },
];
---
<BaseLayout title={t.meta.title} description={t.meta.description} lang={lang}>
  <PageHero eyebrow={t.hero.eyebrow} title={fill(t.hero.h1)} text={t.hero.p} img="/gallery/render-6.jpg" alt={t.hero.alt} />

  <Sec>
    <SecHead index="01" kicker={t.typologies.eyebrow} title={t.typologies.h2} text={t.typologies.p} />
    <div class="lx-typos">
      {t.typologies.items.map((typ, i) => (
        <article class="lx-typo">
          <figure><img src={i === 0 ? '/gallery/render-3.jpg' : '/gallery/render-2.jpg'} alt={typ.name} loading="lazy" /></figure>
          <div class="lx-typo__head"><h3>{typ.name}</h3><span dir="ltr">{typ.surface}</span></div>
          <p class="lx-label">{typ.rooms}</p>
          <p class="lx-p lx-p--muted">{typ.body}</p>
        </article>
      ))}
    </div>
  </Sec>

  <Sec tone="alt">
    <Split img="/gallery/render-9.jpg" alt={t.inclus.alt}>
      <SecHead index="02" kicker={t.inclus.eyebrow} title={t.inclus.h2} text={t.inclus.p} />
      <Checklist items={t.inclus.items} />
    </Split>
  </Sec>

  <Sec tone="light" id="finitions">
    <div class="lx-cols">
      <div>
        <SecHead index="03" kicker={t.finitions.eyebrow} title={t.finitions.h2} text={t.finitions.p} />
        <p class="lx-note">{t.finitions.note}</p>
        <a href={contactHref} class="lx-btn lx-btn--solid">{t.finitions.brochure}</a>
      </div>
      <SpecList rows={finishes} />
    </div>
  </Sec>

  <Sec narrow>
    <SecHead index="04" kicker={t.prix.eyebrow} title={fill(t.prix.h2)} text={fill(t.prix.p)} />
    <div class="lx-prices">
      <p><span>{t.prix.sansAide}</span><s dir="ltr">{site.priceFrom}</s></p>
      <p><span>{t.prix.avecAide}</span><strong dir="ltr">{site.priceWithAid}</strong></p>
    </div>
    <a href={contactHref} class="lx-btn">{t.prix.brochurePrix}</a>
  </Sec>

  <AidBand lang={lang} text={t.banner} />

  <Sec>
    <SecHead index="05" kicker={t.quartier.eyebrow} title={t.quartier.h2} text={t.quartier.p} />
    <Numbered items={t.quartier.items} />
    <a href={projetHref} class="lx-more">{t.quartier.lien}</a>
  </Sec>

  <Sec tone="alt">
    <SecHead index="06" kicker={t.pourVous.eyebrow} title={t.pourVous.h2} />
    <div class="lx-ways3">
      {ways.map(([verb, body]) => (
        <div><h3>{verb}</h3><p>{body}</p></div>
      ))}
    </div>
  </Sec>

  <Cta lang={lang} title={t.cta.title} text={t.cta.text} />
</BaseLayout>
