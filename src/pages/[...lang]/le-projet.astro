---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/v3/PageHero.astro';
import Sec from '../../components/v3/Sec.astro';
import SecHead from '../../components/v3/SecHead.astro';
import Split from '../../components/v3/Split.astro';
import SpecList from '../../components/v3/SpecList.astro';
import Numbered from '../../components/v3/Numbered.astro';
import Checklist from '../../components/v3/Checklist.astro';
import Tiles from '../../components/v3/Tiles.astro';
import AidBand from '../../components/v3/AidBand.astro';
import LinkRow from '../../components/v3/LinkRow.astro';
import Cta from '../../components/v3/Cta.astro';
import { site } from '../../data/site';
import { pick, type Lang } from '../../data/i18n/helpers';
import { projet } from '../../data/i18n/projet';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'ar' } }];
}

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = pick(projet, lang);

// Fill {placeholders} with site values
const fill = (s: string) =>
  s
    .replaceAll('{location}', site.location)
    .replaceAll('{promoter}', site.promoter)
    .replaceAll('{architect}', site.architect)
    .replaceAll('{delivery}', site.delivery)
    .replaceAll('{distance}', site.distance)
    .replaceAll('{buildings}', String(site.buildings))
    .replaceAll('{apartments}', String(site.apartments))
    .replaceAll('{commercial}', String(site.commercial));

const specs = [
  { label: t.fiche.rows[0], value: site.promoter },
  { label: t.fiche.rows[1], value: site.architect },
  { label: t.fiche.rows[2], value: site.location },
  { label: t.fiche.rows[3], value: site.address },
  { label: t.fiche.rows[4], value: t.fiche.standing },
  { label: t.fiche.rows[5], value: t.fiche.logements },
  { label: t.fiche.rows[6], value: site.surfaceRange },
  { label: t.fiche.rows[7], value: t.fiche.commerciaux },
  { label: t.fiche.rows[8], value: t.fiche.stationnement },
  { label: t.fiche.rows[9], value: t.fiche.gestion },
  { label: t.fiche.rows[10], value: t.fiche.eligible },
  { label: t.fiche.rows[11], value: fill(t.fiche.livraison) },
];
---
<BaseLayout title={t.meta.title} description={t.meta.description} lang={lang}>
  <PageHero eyebrow={t.hero.eyebrow} title={fill(t.hero.h1)} text={fill(t.hero.p)} img="/gallery/render-4.jpg" alt={t.hero.alt} />

  <Sec>
    <SecHead index="01" kicker={t.conception.eyebrow} title={t.conception.h2} text={t.conception.p} />
    <Numbered items={t.conception.items} />
  </Sec>

  <Sec tone="alt">
    <Split img="/gallery/render-1.jpg" alt={t.cour.alt}>
      <SecHead index="02" kicker={t.cour.eyebrow} title={t.cour.h2} />
      <p class="lx-p">{fill(t.cour.p1)}</p>
      <p class="lx-p lx-p--muted">{t.cour.p2}</p>
    </Split>
  </Sec>

  <Sec>
    <SecHead index="03" kicker={t.equipements.eyebrow} title={t.equipements.h2} text={t.equipements.p} center />
    <Tiles items={t.equipements.items} />
  </Sec>

  <Sec tone="light">
    <div class="lx-cols">
      <SecHead index="04" kicker={t.gestion.eyebrow} title={t.gestion.h2} text={t.gestion.p} />
      <div>
        <p class="lx-label">{t.gestion.missionsLabel}</p>
        <Checklist items={t.gestion.missions} />
        <p class="lx-note">{t.gestion.note}</p>
      </div>
    </div>
  </Sec>

  <Sec>
    <div class="lx-cols">
      <SecHead index="05" kicker={t.fiche.eyebrow} title={t.fiche.h2} />
      <SpecList rows={specs} />
    </div>
  </Sec>

  <Sec tone="alt" narrow>
    <SecHead index="06" kicker={t.tranches.eyebrow} title={t.tranches.h2} />
    <p class="lx-p">{t.tranches.p1}</p>
    <p class="lx-p lx-p--muted">{t.tranches.p2}</p>
  </Sec>

  <AidBand lang={lang} text={t.banner} />

  <LinkRow
    lang={lang}
    cards={[
      { title: t.cards.appartements[0], text: t.cards.appartements[1], href: lang === 'ar' ? '/ar/appartements' : '/appartements' },
      { title: t.cards.commerces[0], text: t.cards.commerces[1], href: lang === 'ar' ? '/ar/fonds-de-commerce' : '/fonds-de-commerce' },
      { title: fill(t.cards.localisation[0]), text: fill(t.cards.localisation[1]), href: lang === 'ar' ? '/ar/localisation' : '/localisation' },
    ]}
  />

  <Cta lang={lang} />
</BaseLayout>
