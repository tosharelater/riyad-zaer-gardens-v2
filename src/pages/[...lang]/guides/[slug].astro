---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/v3/PageHero.astro';
import Sec from '../../../components/v3/Sec.astro';
import Cta from '../../../components/v3/Cta.astro';
import { pick, type Lang } from '../../../data/i18n/helpers';
import { misc, guides, type Guide } from '../../../data/i18n/misc';

export function getStaticPaths() {
  const langs: (Lang | undefined)[] = [undefined, 'ar'];
  return langs.flatMap((lang) =>
    guides[lang ?? 'fr'].map((g) => ({ params: { lang, slug: g.slug }, props: { guide: g as Guide, lang } }))
  );
}

const { guide, lang = 'fr' } = Astro.props;
const t = pick(misc, lang).guide;
const locale = lang === 'ar' ? 'ar-MA' : 'fr-FR';
const formatDate = (d: string) =>
  new Date(d).toLocaleDateString(locale, { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout title={`${guide.title} — Riyad Zaer Gardens`} description={guide.excerpt} lang={lang}>
  <PageHero eyebrow={pick(misc, lang).guides.eyebrow} title={guide.title} text={t.published.replace('{date}', formatDate(guide.date))} />

  <Sec narrow>
    <div class="lx-prose">
      {guide.body.map((p) => <p>{p}</p>)}
    </div>
    <a href={guide.link.href} class="lx-btn">{guide.link.label}</a>
  </Sec>

  <Cta lang={lang} />
</BaseLayout>
