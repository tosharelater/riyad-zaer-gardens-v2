---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/v3/PageHero.astro';
import Sec from '../../../components/v3/Sec.astro';
import { pick, type Lang } from '../../../data/i18n/helpers';
import { misc, guides } from '../../../data/i18n/misc';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'ar' } }];
}

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = pick(misc, lang).guides;
const items = pick(guides, lang);
const locale = lang === 'ar' ? 'ar-MA' : 'fr-FR';
const formatDate = (d: string) =>
  new Date(d).toLocaleDateString(locale, { day: 'numeric', month: 'long', year: 'numeric' });
const base = lang === 'ar' ? '/ar' : '';
---
<BaseLayout title={t.meta.title} description={t.meta.description} lang={lang}>
  <PageHero eyebrow={t.eyebrow} title={t.h1} text={t.p} />

  <Sec>
    <div class="lx-links lx-links--2">
      {items.map((g) => (
        <a href={`${base}/guides/${g.slug}`} class="lx-link">
          <p class="lx-label">{formatDate(g.date)}</p>
          <h3>{g.title}</h3>
          <p>{g.excerpt}</p>
          <span class="lx-link__go" aria-hidden="true">{lang === 'ar' ? 'اقرأوا ←' : 'Lire →'}</span>
        </a>
      ))}
    </div>
  </Sec>
</BaseLayout>
