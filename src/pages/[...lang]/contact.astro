---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import ContactForm from '../../components/ContactForm.astro';
import { site } from '../../data/site';
import { pick, type Lang } from '../../data/i18n/helpers';
import { contact } from '../../data/i18n/contact';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'ar' } }];
}

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = pick(contact, lang);
const faqHref = lang === 'ar' ? '/ar/faq' : '/faq';
---
<BaseLayout title={t.meta.title} description={t.meta.description} lang={lang}>
  <section class="bg-forest text-cream">
    <div class="container-page py-16 md:py-20">
      <Eyebrow label={t.hero.eyebrow} />
      <h1 class="font-display text-4xl md:text-5xl mt-4 max-w-2xl leading-tight">{t.hero.h1}</h1>
      <p class="mt-6 max-w-xl text-cream/75">{t.hero.p}</p>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="container-page grid lg:grid-cols-[1.1fr_0.9fr] gap-14">
      <div>
        <Eyebrow index="01." label={t.form.eyebrow} />
        <h2 class="font-display text-3xl md:text-4xl text-forest mt-3 mb-8">{t.form.h2}</h2>
        <ContactForm lang={lang} />
      </div>

      <div class="space-y-10">
        <div>
          <Eyebrow index="02." label={t.joindre.eyebrow} />
          <h2 class="font-display text-2xl text-forest mt-3 mb-6">{t.joindre.h2}</h2>
          <ul class="space-y-5">
            <li>
              <p class="text-xs uppercase tracking-wide text-ink/45 mb-1">{t.joindre.tel}</p>
              <a href={`tel:${site.phoneTel}`} class="font-display text-xl text-forest hover:text-gold transition-colors" dir="ltr">{site.phone}</a>
            </li>
            <li>
              <p class="text-xs uppercase tracking-wide text-ink/45 mb-1">{t.joindre.wa}</p>
              <a href={site.whatsapp} class="font-display text-xl text-forest hover:text-gold transition-colors">{lang === 'ar' ? 'راسلونا على واتساب' : 'Écrire sur WhatsApp'}</a>
            </li>
            <li>
              <p class="text-xs uppercase tracking-wide text-ink/45 mb-1">{t.joindre.lieu}</p>
              <p class="text-ink/70">{site.address} — {site.location}</p>
            </li>
          </ul>
        </div>

        <div class="border-t border-forest/10 pt-8">
          <h2 class="font-display text-xl text-forest mb-3">{t.visiter.h2}</h2>
          <p class="text-sm text-ink/65 leading-relaxed">{t.visiter.p}</p>
        </div>

        <div class="border-t border-forest/10 pt-8">
          <h2 class="font-display text-xl text-forest mb-3">{t.questions.h2}</h2>
          <p class="text-sm text-ink/65 leading-relaxed mb-4">{t.questions.p}</p>
          <a href={faqHref} class="text-sm font-semibold text-gold">{t.questions.lien}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
