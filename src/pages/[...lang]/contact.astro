---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/v3/PageHero.astro';
import Sec from '../../components/v3/Sec.astro';
import SecHead from '../../components/v3/SecHead.astro';
import ContactForm from '../../components/ContactForm.astro';
import { site } from '../../data/site';
import { pick, type Lang } from '../../data/i18n/helpers';
import { contact } from '../../data/i18n/contact';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'ar' } }];
}

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = pick(contact, lang);
const faqHref = lang === 'ar' ? '/ar/faq' : '/faq';
---
<BaseLayout title={t.meta.title} description={t.meta.description} lang={lang}>
  <PageHero eyebrow={t.hero.eyebrow} title={t.hero.h1} text={t.hero.p} />

  <Sec>
    <div class="lx-contact2">
      <div>
        <SecHead index="01" kicker={t.form.eyebrow} title={t.form.h2} />
        <ContactForm lang={lang} />
      </div>
      <aside class="lx-reach">
        <SecHead index="02" kicker={t.joindre.eyebrow} title={t.joindre.h2} />
        <dl>
          <div><dt>{t.joindre.tel}</dt><dd><a href={`tel:${site.phoneTel}`} dir="ltr">{site.phone}</a></dd></div>
          <div><dt>{t.joindre.wa}</dt><dd><a href={site.whatsapp}>{lang === 'ar' ? 'راسلونا على واتساب' : 'Écrire sur WhatsApp'}</a></dd></div>
          <div><dt>{t.joindre.lieu}</dt><dd>{site.address} — {site.location}</dd></div>
        </dl>
        <h3 class="lx-h4">{t.visiter.h2}</h3>
        <p class="lx-p lx-p--muted">{t.visiter.p}</p>
        <h3 class="lx-h4">{t.questions.h2}</h3>
        <p class="lx-p lx-p--muted">{t.questions.p}</p>
        <a href={faqHref} class="lx-more">{t.questions.lien}</a>
      </aside>
    </div>
  </Sec>
</BaseLayout>
