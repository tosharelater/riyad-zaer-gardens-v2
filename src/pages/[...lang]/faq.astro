---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/v3/PageHero.astro';
import Sec from '../../components/v3/Sec.astro';
import Faq from '../../components/v3/Faq.astro';
import Cta from '../../components/v3/Cta.astro';
import { site } from '../../data/site';
import { pick, type Lang } from '../../data/i18n/helpers';
import { faq } from '../../data/i18n/faq';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'ar' } }];
}

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = pick(faq, lang);

const fill = (s: string) =>
  s
    .replaceAll('{location}', site.location)
    .replaceAll('{promoter}', site.promoter)
    .replaceAll('{architect}', site.architect)
    .replaceAll('{phone}', site.phone)
    .replaceAll('{priceFrom}', site.priceFrom)
    .replaceAll('{priceWithAid}', site.priceWithAid)
    .replaceAll('{commerceSurface}', site.commerceSurface)
    .replaceAll('{commercePrice}', site.commercePrice)
    .replaceAll('{delivery}', site.delivery);

const groups = t.groups.map((g) => ({
  title: g.title,
  items: g.items.map((i) => ({ q: fill(i.q), a: fill(i.a) })),
}));
---
<BaseLayout title={t.meta.title} description={t.meta.description} lang={lang}>
  <PageHero eyebrow={t.hero.eyebrow} title={t.hero.h1} text={fill(t.hero.p)} />

  <Sec narrow>
    {groups.map((g) => (
      <div class="lx-faqgroup">
        <h2 class="lx-h3">{g.title}</h2>
        <Faq items={g.items} />
      </div>
    ))}
  </Sec>

  <Cta lang={lang} title={t.cta.title} text={t.cta.text} />
</BaseLayout>
