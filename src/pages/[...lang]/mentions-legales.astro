---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import { site } from '../../data/site';
import { pick, type Lang } from '../../data/i18n/helpers';
import { mentions } from '../../data/i18n/mentions';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'ar' } }];
}

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = pick(mentions, lang);

const fill = (s: string) =>
  s.replaceAll('{domain}', site.domain).replaceAll('{phone}', site.phone);
---
<BaseLayout title={t.meta.title} description={t.meta.description} lang={lang} noindex>
  <section class="bg-forest text-cream">
    <div class="container-page py-14 md:py-16">
      <Eyebrow label={t.hero.eyebrow} />
      <h1 class="font-display text-4xl md:text-6xl mt-4">{t.hero.h1}</h1>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="container-page max-w-2xl prose-legal space-y-12 text-ink/75 text-sm leading-relaxed">
      <div>
        <h2 class="font-display text-xl text-forest mb-4">{t.editeur.h2}</h2>
        <p>{fill(t.editeur.p)}</p>
        <ul class="mt-3 space-y-1">
          <li><strong>{t.editeur.raison}</strong> : Lamanoussa SARL AU</li>
          <li><strong>{t.editeur.forme}</strong> : SARL AU</li>
          <li><strong>{t.editeur.tel}</strong> : <span dir="ltr">{site.phone}</span></li>
        </ul>
      </div>

      <div>
        <h2 class="font-display text-xl text-forest mb-4">{t.propriete.h2}</h2>
        <p>{t.propriete.p}</p>
      </div>

      <div>
        <h2 class="font-display text-xl text-forest mb-4">{t.infos.h2}</h2>
        <p>{t.infos.p1}</p>
        <p class="mt-3">{t.infos.p2}</p>
      </div>

      <div id="confidentialite">
        <h2 class="font-display text-xl text-forest mb-4">{t.confidentialite.h2}</h2>
        <h3 class="font-semibold text-ink mb-2 mt-4">{t.confidentialite.h3a}</h3>
        <p>{t.confidentialite.pa}</p>
        <h3 class="font-semibold text-ink mb-2 mt-4">{t.confidentialite.h3b}</h3>
        <p>{t.confidentialite.pb}</p>
        <h3 class="font-semibold text-ink mb-2 mt-4">{t.confidentialite.h3c}</h3>
        <p>{fill(t.confidentialite.pc)}</p>
      </div>

      <div>
        <h2 class="font-display text-xl text-forest mb-4">{t.cookies.h2}</h2>
        <p>{t.cookies.p}</p>
      </div>
    </div>
  </section>
</BaseLayout>
