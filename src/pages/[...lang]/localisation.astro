---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/v3/PageHero.astro';
import Sec from '../../components/v3/Sec.astro';
import SecHead from '../../components/v3/SecHead.astro';
import Split from '../../components/v3/Split.astro';
import Numbered from '../../components/v3/Numbered.astro';
import Checklist from '../../components/v3/Checklist.astro';
import LinkRow from '../../components/v3/LinkRow.astro';
import Cta from '../../components/v3/Cta.astro';
import { site } from '../../data/site';
import { pick, type Lang } from '../../data/i18n/helpers';
import { localisation } from '../../data/i18n/localisation';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'ar' } }];
}

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = pick(localisation, lang);

const fill = (s: string) =>
  s
    .replaceAll('{location}', site.location)
    .replaceAll('{distance}', site.distance)
    .replaceAll('{buildings}', String(site.buildings))
    .replaceAll('{surfaceRange}', site.surfaceRange);

const mapsUrl = 'https://www.google.com/maps/search/?api=1&query=Avenue+Mohammed+VI+Ain+Aouda+Rabat';
const contactHref = lang === 'ar' ? '/ar/contact' : '/contact';
---
<BaseLayout title={t.meta.title} description={t.meta.description} lang={lang}>
  <PageHero eyebrow={t.hero.eyebrow} title={fill(t.hero.h1)} text={fill(t.hero.p)} img="/gallery/render-11.jpg" alt={t.hero.alt} />

  <Sec>
    <SecHead index="01" kicker={t.carte.eyebrow} title={t.carte.h2} />
    <div class="lx-map">
      <iframe
        title={t.carte.iframeTitle}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        src="https://www.google.com/maps?q=Avenue+Mohammed+VI,+Ain+Aouda,+Rabat&output=embed"
      ></iframe>
    </div>
    <a href={mapsUrl} target="_blank" rel="noopener" class="lx-btn">{t.carte.maps}</a>
  </Sec>

  <Sec tone="alt">
    <SecHead index="02" kicker={t.acces.eyebrow} title={t.acces.h2} />
    <Numbered items={t.acces.items} />
  </Sec>

  <Sec>
    <Split img="/gallery/render-6.jpg" alt={t.quartier.alt}>
      <SecHead index="03" kicker={t.quartier.eyebrow} title={fill(t.quartier.h2)} />
      <p class="lx-p">{fill(t.quartier.p1)}</p>
      <p class="lx-p lx-p--muted">{t.quartier.p2}</p>
      <Checklist items={t.quartier.already} />
      <p class="lx-note">{t.quartier.note}</p>
    </Split>
  </Sec>

  <Sec tone="light" narrow>
    <SecHead index="04" kicker={t.visite.eyebrow} title={t.visite.h2} text={t.visite.p} />
    <a href={contactHref} class="lx-btn lx-btn--solid">{t.visite.btn}</a>
  </Sec>

  <LinkRow
    lang={lang}
    cards={[
      { title: fill(t.cards.projet[0]), text: fill(t.cards.projet[1]), href: lang === 'ar' ? '/ar/le-projet' : '/le-projet' },
      { title: fill(t.cards.appartements[0]), text: fill(t.cards.appartements[1]), href: lang === 'ar' ? '/ar/appartements' : '/appartements' },
    ]}
  />

  <Cta lang={lang} />
</BaseLayout>
