---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/v3/PageHero.astro';
import Sec from '../../components/v3/Sec.astro';
import SecHead from '../../components/v3/SecHead.astro';
import Split from '../../components/v3/Split.astro';
import SpecList from '../../components/v3/SpecList.astro';
import Numbered from '../../components/v3/Numbered.astro';
import LinkRow from '../../components/v3/LinkRow.astro';
import Cta from '../../components/v3/Cta.astro';
import { site } from '../../data/site';
import { pick, type Lang } from '../../data/i18n/helpers';
import { fonds } from '../../data/i18n/fonds';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'ar' } }];
}

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = pick(fonds, lang);

const fill = (s: string) =>
  s
    .replaceAll('{location}', site.location)
    .replaceAll('{distance}', site.distance)
    .replaceAll('{delivery}', site.delivery)
    .replaceAll('{commerceSurface}', site.commerceSurface)
    .replaceAll('{commercePrice}', site.commercePrice)
    .replaceAll('{buildings}', String(site.buildings))
    .replaceAll('{apartments}', String(site.apartments))
    .replaceAll('{commercial}', String(site.commercial));

const specs = [
  { label: t.offre.rows[0], value: t.offre.lots },
  { label: t.offre.rows[1], value: site.commerceSurface },
  { label: t.offre.rows[2], value: fill(t.offre.prix) },
  { label: t.offre.rows[3], value: t.offre.emplacement },
  { label: t.offre.rows[4], value: fill(t.offre.livraison) },
];
---
<BaseLayout title={t.meta.title} description={t.meta.description} lang={lang}>
  <PageHero eyebrow={t.hero.eyebrow} title={fill(t.hero.h1)} text={t.hero.p} img="/gallery/render-8.jpg" alt={t.hero.alt} />

  <Sec>
    <Split img="/gallery/render-5.jpg" alt={t.offre.alt}>
      <SecHead index="01" kicker={t.offre.eyebrow} title={t.offre.h2} />
      <SpecList rows={specs} />
      <p class="lx-p lx-p--muted">{t.offre.p}</p>
    </Split>
  </Sec>

  <Sec tone="alt">
    <SecHead index="02" kicker={t.emplacement.eyebrow} title={t.emplacement.h2} />
    <Numbered items={t.emplacement.items.map((i) => ({ title: i.title, body: fill(i.body) }))} />
  </Sec>

  <Sec tone="light" narrow>
    <SecHead index="03" kicker={t.investisseurs.eyebrow} title={t.investisseurs.h2} />
    <p class="lx-p">{t.investisseurs.p1}</p>
    <p class="lx-p lx-p--muted">{t.investisseurs.p2}</p>
  </Sec>

  <LinkRow
    lang={lang}
    cards={[
      { title: fill(t.cards.projet[0]), text: fill(t.cards.projet[1]), href: lang === 'ar' ? '/ar/le-projet' : '/le-projet' },
      { title: fill(t.cards.localisation[0]), text: fill(t.cards.localisation[1]), href: lang === 'ar' ? '/ar/localisation' : '/localisation' },
    ]}
  />

  <Cta lang={lang} title={t.cta.title} text={t.cta.text} />
</BaseLayout>
