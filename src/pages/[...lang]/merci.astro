---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { pick, type Lang } from '../../data/i18n/helpers';
import { misc } from '../../data/i18n/misc';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'ar' } }];
}

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = pick(misc, lang).merci;
const fill = (s: string) => s.replaceAll('{phone}', site.phone);
const projetHref = lang === 'ar' ? '/ar/le-projet' : '/le-projet';
---
<BaseLayout title={t.meta.title} description={t.meta.description} lang={lang} noindex>
  <section class="lx-endpage">
    <p class="lx-kick">{t.eyebrow}</p>
    <h1 class="lx-h2">{t.h1}</h1>
    <p class="lx-stext">{t.p1}</p>
    <p class="lx-stext">{fill(t.p2)}</p>
    <div class="lx-actions">
      <a href={`tel:${site.phoneTel}`} class="lx-btn lx-btn--solid">{t.call}</a>
      <a href={projetHref} class="lx-btn">{t.project}</a>
    </div>
  </section>
</BaseLayout>
