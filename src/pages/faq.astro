---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Accordion from '../components/Accordion.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { site } from '../data/site';

const groups = [
  {
    title: 'Le projet',
    items: [
      { q: 'Où se situe exactement Riyad Zaer Gardens ?', a: `Le projet se situe à ${site.location}, Km 25 sur l'Avenue Mohammed VI, à 20 minutes de Rabat par l'autoroute.` },
      { q: 'Qui est le promoteur ?', a: `Le projet est développé par ${site.promoter}. La conception architecturale est signée ${site.architect}.` },
      { q: 'Comment la résidence sera-t-elle gérée ?', a: 'La résidence sera confiée à une société de syndic professionnelle. Elle assurera la gestion des parties communes, la maintenance des installations, la supervision du gardiennage et le contrôle des accès.' },
      { q: 'Y a-t-il des espaces verts ?', a: 'Oui. Les immeubles s’organisent autour d’une cour centrale plantée, avec des aires de jeux. C’est un espace calme et sécurisé réservé aux résidents.' },
      { q: 'Que comprend la première tranche ?', a: 'La première tranche est composée d’un îlot complet organisé autour d’une cour centrale plantée, soit 120 appartements et 49 fonds de commerce, avec deux niveaux de parking en sous-sol.' },
      { q: 'Y aura-t-il d’autres tranches ?', a: 'Oui. Riyad Zaer Gardens est conçu pour se développer en plusieurs tranches. La première est celle commercialisée aujourd’hui.' },
    ],
  },
  {
    title: 'Les appartements',
    items: [
      { q: 'Quelles typologies sont proposées ?', a: 'Deux typologies : des F3 et des F4.' },
      { q: 'Quelles sont les surfaces ?', a: 'Les appartements font de 65 à 86 m², selon la typologie et l’étage. Les F3 se situent autour de 68 à 72 m², les F4 autour de 77 à 86 m².' },
      { q: 'Les appartements sont-ils livrés finis ?', a: 'Oui. Les logements sont livrés avec leurs finitions. Aucun travaux n’est à prévoir avant d’emménager.' },
      { q: 'Quels sont les équipements de la résidence ?', a: 'Chaque immeuble dispose d’un ascenseur. La résidence s’organise autour d’une cour centrale plantée avec des aires de jeux, et comprend un parking en sous-sol, un contrôle des accès, de la vidéosurveillance et un service de gardiennage.' },
      { q: 'Le parking est-il compris dans le prix ?', a: 'Non. Le stationnement se trouve en sous-sol, sur deux niveaux couverts. Les places sont titrées et proposées en supplément du prix de l’appartement.' },
      { q: 'Quelles sont les finitions livrées ?', a: 'Les appartements sont livrés finis : sols en céramique ou parquet stratifié, menuiseries aluminium, volets roulants motorisés, douche à l’italienne, faux plafonds avec éclairage intégré et cuisine équipée de meubles.' },
      { q: 'Les appartements ont-ils un balcon ?', a: 'Selon le lot, les appartements disposent d’un balcon ou d’une terrasse. Certains comprennent également une buanderie et des placards intégrés.' },
    ],
  },
  {
    title: "Les prix et l'aide au logement",
    items: [
      { q: 'Quel est le prix d’un appartement ?', a: `Les prix démarrent à ${site.priceFrom}. Le montant exact dépend de la typologie, de la surface et de l'étage.` },
      { q: "Qu'est-ce que change l'aide au logement ?", a: `Riyad Zaer Gardens est éligible au programme d'aide au logement de l'État. Selon votre situation, le prix d'entrée peut passer de ${site.priceFrom} à ${site.priceWithAid}.` },
      { q: "Suis-je éligible à l'aide au logement ?", a: `L'éligibilité dépend de votre situation personnelle. Nos conseillers la vérifient avec vous gratuitement, sans engagement. Contactez-nous au ${site.phone}.` },
      { q: "Les fonds de commerce sont-ils concernés par l'aide au logement ?", a: "Non. Le programme d'aide au logement concerne uniquement les logements." },
      { q: 'Comment obtenir la grille de prix complète ?', a: 'La grille de prix est transmise avec la brochure, après un premier échange avec un conseiller. Vous pouvez en faire la demande depuis la page Contact.' },
    ],
  },
  {
    title: 'Les fonds de commerce',
    items: [
      { q: 'Combien de locaux sont disponibles ?', a: 'La première tranche compte 49 fonds de commerce.' },
      { q: 'Quelles sont les surfaces et les prix ?', a: `Les locaux font ${site.commerceSurface}, à partir de ${site.commercePrice}.` },
      { q: 'Où sont situés les locaux ?', a: 'En pied d’immeuble, sur l’Avenue Mohammed VI.' },
    ],
  },
  {
    title: "L'achat et la livraison",
    items: [
      { q: 'Quand la livraison est-elle prévue ?', a: `La livraison est prévue en ${site.delivery}.` },
      { q: 'Peut-on visiter un appartement témoin ?', a: 'Pas pour le moment : le chantier est en cours de démarrage. Nous organisons en revanche des visites du site pour situer les immeubles et les espaces extérieurs.' },
      { q: 'Peut-on acheter pour louer ?', a: 'Oui. Les appartements comme les fonds de commerce peuvent être achetés dans une logique d’investissement locatif.' },
      { q: 'Je vis à l’étranger, comment procéder ?', a: 'Contactez-nous par WhatsApp ou par téléphone. Nous vous transmettons la brochure et vous accompagnons à distance dans les démarches.' },
    ],
  },
];
---
<BaseLayout
  title="Questions fréquentes — Riyad Zaer Gardens, Aïn Aouda"
  description="Prix, surfaces, aide au logement, livraison, parking : toutes les réponses sur les appartements et commerces de Riyad Zaer Gardens à Aïn Aouda."
>
  <section class="bg-forest text-cream">
    <div class="container-page py-16 md:py-20">
      <Eyebrow label="FAQ" />
      <h1 class="font-display text-4xl md:text-5xl mt-4 max-w-2xl leading-tight">Questions fréquentes</h1>
      <p class="mt-6 max-w-xl text-cream/75">
        Les réponses aux questions que l’on nous pose le plus souvent sur Riyad Zaer Gardens. Si vous ne trouvez pas la vôtre, appelez-nous au {site.phone}.
      </p>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="container-page max-w-3xl space-y-16">
      {groups.map((g) => (
        <div>
          <h2 class="font-display text-3xl md:text-4xl text-forest mb-6">{g.title}</h2>
          <Accordion items={g.items} />
        </div>
      ))}
    </div>
  </section>

  <CtaBlock title="Une question qui n'est pas dans la liste ?" text="Appelez-nous ou laissez-nous vos coordonnées : un conseiller vous répond directement." />
</BaseLayout>
