---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import CtaBlock from '../components/CtaBlock.astro';
import SpecTable from '../components/SpecTable.astro';
import NumberedFeatures from '../components/NumberedFeatures.astro';
import LinkCards from '../components/LinkCards.astro';
import PhotoCollage from '../components/PhotoCollage.astro';
import { site } from '../data/site';

const specs = [
  { label: 'Nombre de lots', value: '49' },
  { label: 'Surfaces', value: site.commerceSurface },
  { label: 'Prix', value: `à partir de ${site.commercePrice}` },
  { label: 'Emplacement', value: 'Rez-de-chaussée, Avenue Mohammed VI' },
  { label: 'Livraison', value: `Prévue en ${site.delivery}` },
];

const reasons = [
  { title: 'Une clientèle sur place', body: '120 appartements sont livrés dans la même tranche. Les premiers clients habitent au-dessus du local.' },
  { title: 'Une implantation en angle', body: 'Le terrain donne sur trois voies, dont un axe principal large au sud. Les locaux sont visibles depuis plusieurs directions.' },
  { title: 'Un quartier en développement', body: `${site.location} se développe rapidement. S’installer maintenant, c’est prendre position avant que la zone ne soit entièrement construite.` },
  { title: 'Un stationnement enterré', body: 'Le parking est en sous-sol. Les trottoirs et les abords restent dégagés devant les vitrines.' },
];
---
<BaseLayout
  title="Fonds de commerce à Aïn Aouda — Riyad Zaer Gardens"
  description="49 fonds de commerce de 13 à 30 m² en pied d'immeuble à Aïn Aouda, sur l'Avenue Mohammed VI. À partir de 15 000 DH le m². Livraison prévue en 2028."
>
  <section class="hero relative bg-forest text-cream overflow-hidden">
    <div class="absolute inset-0">
      <img src="/gallery/render-8.jpg" alt="Fonds de commerce Riyad Zaer Gardens" class="w-full h-full object-cover opacity-40" />
      <div class="absolute inset-0 bg-gradient-to-t from-forest via-forest/80 to-forest/50"></div>
    </div>
    <div class="relative container-page py-24 md:py-32">
      <Eyebrow label="Fonds de commerce" />
      <h1 class="font-display text-4xl md:text-5xl mt-5 leading-tight max-w-2xl animate-fade-up">Fonds de commerce à {site.location}</h1>
      <div class="divider-gold my-7 animate-fade-up" style="animation-delay:.15s"></div>
      <p class="max-w-xl text-cream/75 animate-fade-up" style="animation-delay:.25s">
        La première tranche de Riyad Zaer Gardens compte 49 fonds de commerce, de 13 à 30 m², installés en rez-de-chaussée sur l’Avenue Mohammed VI. Ces locaux s’adressent aux commerçants comme aux investisseurs.
      </p>
    </div>
  </section>

  <section class="section bg-white overflow-hidden">
    <div class="container-page grid md:grid-cols-2 gap-16 md:gap-24 items-center">
      <div>
        <Eyebrow index="01." label="L'offre" />
        <h2 class="font-display text-4xl md:text-6xl text-forest mt-4 mb-8">49 locaux de 13 à 30 m²</h2>
        <SpecTable rows={specs} />
        <p class="text-ink/70 leading-relaxed mt-8">
          Les surfaces proposées conviennent aux commerces de proximité : alimentation, services, restauration rapide, santé, beauté ou petits bureaux.
        </p>
      </div>
      <div class="md:pr-8">
        <PhotoCollage
          images={['/gallery/render-8.jpg', '/gallery/render-6.jpg', '/gallery/render-12.jpg']}
          alt="Locaux commerciaux Riyad Zaer Gardens"
          badgeIcon="store"
          badgeValue="49"
          badgeLabel="Locaux"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="max-w-2xl mb-16">
        <Eyebrow index="02." label="Emplacement" />
        <h2 class="font-display text-4xl md:text-6xl text-forest mt-4 mb-5">Quatre raisons de choisir cet emplacement</h2>
      </div>
      <NumberedFeatures items={reasons} />
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-page max-w-2xl">
      <Eyebrow index="03." label="Investisseurs" />
      <h2 class="font-display text-4xl md:text-6xl text-forest mt-4 mb-6">Un bien commercial à louer</h2>
      <p class="text-ink/65 leading-relaxed mb-4">
        Un local commercial dans un quartier neuf constitue un actif simple à mettre en location, avec une demande qui se construit en même temps que le quartier.
      </p>
      <p class="text-ink/65 leading-relaxed">
        Les surfaces restent maîtrisées, ce qui permet d’entrer avec un budget mesuré.
      </p>
    </div>
  </section>

  <LinkCards
    cards={[
      { title: 'Le projet', text: `${site.buildings} immeubles, ${site.apartments} appartements, ${site.commercial} commerces`, href: '/le-projet' },
      { title: 'La localisation', text: `${site.location}, ${site.distance}`, href: '/localisation' },
    ]}
  />

  <CtaBlock title="Réserver un local commercial" text="Laissez-nous vos coordonnées. Un conseiller vous rappelle avec les surfaces encore disponibles et les conditions de réservation." />
</BaseLayout>
