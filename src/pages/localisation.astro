---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import CtaBlock from '../components/CtaBlock.astro';
import NumberedFeatures from '../components/NumberedFeatures.astro';
import LinkCards from '../components/LinkCards.astro';
import PhotoCollage from '../components/PhotoCollage.astro';
import { site } from '../data/site';

const access = [
  { title: 'Depuis Rabat', body: 'Environ 20 minutes par l’autoroute et l’Avenue Mohammed VI.' },
  { title: 'Depuis Témara et Salé', body: 'La zone est reliée aux principaux axes qui desservent Rabat, Témara et Salé.' },
  { title: 'En voiture', body: 'L’accès se fait directement depuis l’Avenue Mohammed VI, sans traversée de centre-ville.' },
  { title: 'Trois accès possibles', body: 'Le terrain est bordé par trois voies : un axe principal large au sud, une voie secondaire à l’ouest et une troisième au nord.' },
];

const already = ['Une pharmacie', 'Un cabinet vétérinaire', 'Des commerces et services de proximité intégrés au quartier'];

const mapsUrl = 'https://www.google.com/maps/search/?api=1&query=Avenue+Mohammed+VI+Ain+Aouda+Rabat';
---
<BaseLayout
  title="Où se situe Riyad Zaer Gardens — Aïn Aouda, Rabat"
  description="Riyad Zaer Gardens se situe Km 25, Avenue Mohammed VI à Aïn Aouda, à 20 minutes de Rabat par l'autoroute. Découvrez l'accès et le quartier."
>
  <section class="hero relative bg-forest text-cream overflow-hidden">
    <div class="absolute inset-0">
      <img src="/gallery/render-11.jpg" alt="Localisation de Riyad Zaer Gardens à Aïn Aouda" class="w-full h-full object-cover opacity-40" />
      <div class="absolute inset-0 bg-gradient-to-t from-forest via-forest/80 to-forest/50"></div>
    </div>
    <div class="relative container-page py-24 md:py-32">
      <Eyebrow label="Localisation" />
      <h1 class="font-display text-4xl md:text-5xl mt-5 leading-tight max-w-2xl animate-fade-up">Km 25, Avenue Mohammed VI, {site.location}</h1>
      <div class="divider-gold my-7 animate-fade-up" style="animation-delay:.15s"></div>
      <p class="max-w-xl text-cream/75 animate-fade-up" style="animation-delay:.25s">
        Riyad Zaer Gardens se situe à {site.location}, sur l’Avenue Mohammed VI, {site.distance}. C’est l’équilibre que cherchent beaucoup d’habitants de la région : le calme et la verdure, sans s’éloigner de la ville.
      </p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-page">
      <Eyebrow index="01." label="La carte" />
      <h2 class="font-display text-4xl md:text-6xl text-forest mt-4 mb-10">Situer le projet</h2>
      <div class="aspect-[16/8] w-full overflow-hidden frame-corners">
        <iframe
          title="Carte de situation de Riyad Zaer Gardens à Aïn Aouda"
          class="w-full h-full"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src="https://www.google.com/maps?q=Avenue+Mohammed+VI,+Ain+Aouda,+Rabat&output=embed"
        ></iframe>
      </div>
      <a href={mapsUrl} target="_blank" rel="noopener" class="btn btn-dark mt-8">Ouvrir dans Google Maps</a>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="max-w-2xl mb-16">
        <Eyebrow index="02." label="Accès" />
        <h2 class="font-display text-4xl md:text-6xl text-forest mt-4 mb-5">Comment y accéder</h2>
      </div>
      <NumberedFeatures items={access} />
    </div>
  </section>

  <section class="section bg-white overflow-hidden">
    <div class="container-page grid md:grid-cols-2 gap-16 md:gap-24 items-center">
      <div>
        <Eyebrow index="03." label="Le quartier" />
        <h2 class="font-display text-4xl md:text-6xl text-forest mt-4 mb-6">Vivre à {site.location}</h2>
        <p class="text-ink/65 leading-relaxed mb-4">
          {site.location} est l’une des zones qui se développent le plus rapidement autour de Rabat. On y trouve encore de l’espace, de la verdure et un rythme plus calme qu’en ville.
        </p>
        <p class="text-ink/65 leading-relaxed mb-7">
          Le quartier n’est pas à construire entièrement : des services de proximité sont déjà installés à quelques minutes du projet.
        </p>
        <ul class="space-y-3 mb-6">
          {already.map((a) => (
            <li class="flex items-start gap-3 text-sm text-ink/70"><span class="text-gold mt-0.5">✓</span>{a}</li>
          ))}
        </ul>
        <p class="text-sm text-ink/50 italic">Et 49 commerces viendront s’ajouter en rez-de-chaussée de la résidence, à la livraison.</p>
      </div>
      <div class="md:pr-8">
        <PhotoCollage
          images={['/gallery/render-6.jpg', '/gallery/render-4.jpg', '/gallery/render-11.jpg']}
          alt="Quartier Aïn Aouda"
          badgeIcon="pin"
          badgeValue="20 min"
          badgeLabel="De Rabat"
        />
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-page max-w-2xl">
      <Eyebrow index="04." label="Visite" />
      <h2 class="font-display text-4xl md:text-6xl text-forest mt-4 mb-6">Venir voir le site</h2>
      <p class="text-ink/70 leading-relaxed mb-8">
        Le meilleur moyen de se faire une idée reste de venir sur place. Nous organisons des visites du site et vous accompagnons pour situer les immeubles et les espaces extérieurs.
      </p>
      <a href="/contact" class="btn btn-dark">Planifier une visite</a>
    </div>
  </section>

  <LinkCards
    cards={[
      { title: 'Le projet', text: `${site.buildings} immeubles autour d'espaces verts`, href: '/le-projet' },
      { title: 'Les appartements', text: `F3 et F4, ${site.surfaceRange}`, href: '/appartements' },
    ]}
  />

  <CtaBlock />
</BaseLayout>
