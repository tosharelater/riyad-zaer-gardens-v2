---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';
---
<BaseLayout
  title="Contact — Riyad Zaer Gardens, Aïn Aouda"
  description="Contactez Riyad Zaer Gardens à Aïn Aouda : demande de brochure, prix, visite du site. Un conseiller vous rappelle. Tél. 07 08 08 08 39."
>
  <section class="bg-forest text-cream">
    <div class="container-page py-16 md:py-20">
      <Eyebrow label="Contact" />
      <h1 class="font-display text-4xl md:text-5xl mt-4 max-w-2xl leading-tight">Contacter Riyad Zaer Gardens</h1>
      <p class="mt-6 max-w-xl text-cream/75">
        Une question sur les typologies, les prix ou l’aide au logement ? Laissez-nous vos coordonnées : un conseiller vous rappelle et vous transmet la brochure du projet.
      </p>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="container-page grid lg:grid-cols-[1.1fr_0.9fr] gap-14">
      <div>
        <Eyebrow index="01." label="Être rappelé" />
        <h2 class="font-display text-3xl md:text-4xl text-forest mt-3 mb-8">Laissez-nous vos coordonnées</h2>
        <ContactForm />
      </div>

      <div class="space-y-10">
        <div>
          <Eyebrow index="02." label="Nous joindre directement" />
          <h2 class="font-display text-2xl text-forest mt-3 mb-6">Autres moyens de contact</h2>
          <ul class="space-y-5">
            <li>
              <p class="text-xs uppercase tracking-wide text-ink/45 mb-1">Par téléphone</p>
              <a href={`tel:${site.phoneTel}`} class="font-display text-xl text-forest hover:text-gold transition-colors">{site.phone}</a>
            </li>
            <li>
              <p class="text-xs uppercase tracking-wide text-ink/45 mb-1">Sur WhatsApp</p>
              <a href={site.whatsapp} class="font-display text-xl text-forest hover:text-gold transition-colors">Écrire sur WhatsApp</a>
            </li>
            <li>
              <p class="text-xs uppercase tracking-wide text-ink/45 mb-1">Sur place</p>
              <p class="text-ink/70">{site.address} — {site.location}</p>
            </li>
          </ul>
        </div>

        <div class="border-t border-forest/10 pt-8">
          <h2 class="font-display text-xl text-forest mb-3">Visiter le site du projet</h2>
          <p class="text-sm text-ink/65 leading-relaxed">
            Nous organisons des visites sur le terrain pour situer les immeubles, les espaces verts et les commerces. Indiquez vos disponibilités dans le formulaire, nous convenons d’un créneau avec vous.
          </p>
        </div>

        <div class="border-t border-forest/10 pt-8">
          <h2 class="font-display text-xl text-forest mb-3">Vous vous posez encore des questions ?</h2>
          <p class="text-sm text-ink/65 leading-relaxed mb-4">
            Les réponses aux questions les plus courantes sur les prix, l’aide au logement et la livraison sont regroupées sur une page dédiée.
          </p>
          <a href="/faq" class="text-sm font-semibold text-gold">Consulter la FAQ →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
